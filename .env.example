# Copy this file to .env and fill in your own values.
# .env is git-ignored and is never written to logs or config.json.

# OpenHands Cloud API key: https://app.all-hands.dev/settings/api-keys
OPENHANDS_API_KEY=replace-with-your-openhands-api-key

# Base URL of the OpenHands Cloud API (do not include /api/v1).
OPENHANDS_API_URL=https://app.all-hands.dev

# Optional model override for the conversion conversation.
# OPENHANDS_LLM_MODEL=claude-sonnet-4-5-20250929

# Permanent private workspace repository used for conversions.
PY2CARDPUTER_GITHUB_REPOSITORY=ITDUDE207/Py2Cardputer-Workspace

# Local Arduino CLI executable and target board.
ARDUINO_CLI_PATH=arduino-cli
ARDUINO_FQBN=m5stack:esp32:m5stack_cardputer

# Optional path and timing overrides.
# PY2CARDPUTER_BUILD_DIR=builds
# PY2CARDPUTER_LOG_DIR=logs
# PY2CARDPUTER_WORKSPACE_DIR=workspace
# PY2CARDPUTER_POLL_INTERVAL=5
# PY2CARDPUTER_STARTUP_TIMEOUT=900
# PY2CARDPUTER_EXECUTION_TIMEOUT=5400
# PY2CARDPUTER_REQUEST_TIMEOUT=60

# Desktop notifications (the in-app banner is always shown; the native toast is best effort).
# PY2CARDPUTER_NOTIFICATIONS=true
# PY2CARDPUTER_NATIVE_NOTIFICATIONS=true
